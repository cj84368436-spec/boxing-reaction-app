{
  "name": "boxing-talent-p0-canonical-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:preview-session": "tsc -p tsconfig.preview-session.json",
    "prebuild:app": "node scripts/apply-granite-windows-path-patch.mjs",
    "build:app": "ait build",
    "predev": "node scripts/apply-granite-windows-path-patch.mjs",
    "dev": "granite dev",
    "postinstall": "node scripts/apply-granite-windows-path-patch.mjs",
    "test": "npm run build && npm run test:contracts && node --test tests/*.test.mjs && npm run test:app",
    "test:app": "jest --runInBand",
    "test:contracts": "tsc -p tsconfig.contract-tests.json",
    "typecheck:app": "tsc -p tsconfig.app.json --noEmit",
    "prepreview:p0": "npm run build && npm run build:preview-session",
    "preview:p0": "node tools/browser-preview/server.mjs",
    "pretest:preview": "npm run build && npm run build:preview-session",
    "test:preview": "node --test tools/browser-preview/test-preview-contract.mjs",
    "audit:motion": "node tools/mocap/audit-motion-assets.mjs",
    "check": "npm run test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@apps-in-toss/framework": "2.10.10",
    "@granite-js/native": "1.0.43",
    "@granite-js/react-native": "1.0.43",
    "@granite-js/video": "1.0.43",
    "@toss/tds-react-native": "2.0.5",
    "brick-module": "0.5.1",
    "react": "19.2.3",
    "react-native": "0.84.0",
    "react-native-svg": "15.15.3"
  },
  "devDependencies": {
    "@babel/core": "7.28.5",
    "@babel/runtime": "7.28.4",
    "@granite-js/plugin-hermes": "1.0.43",
    "@granite-js/plugin-router": "1.0.43",
    "@testing-library/react-native": "13.3.3",
    "@types/babel__core": "^7.20.5",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/react": "19.2.0",
    "@types/react-test-renderer": "19.1.0",
    "babel-preset-granite": "1.0.43",
    "jest": "^29.7.0",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.8.3"
  },
  "dependenciesMeta": {
    "hermes-compiler": {
      "unplugged": true
    }
  }
}
